# Base URL of the loan applications API (see ../BACKEND). No trailing slash.
# Development default matches BACKEND/.env.example's PORT=5001.
# In production (Vercel), the frontend and API are served from the same origin — set this to
# the relative path `/api` there instead, so the browser calls e.g. /api/applications rather
# than a separate cross-origin backend URL.
VITE_API_BASE_URL=http://localhost:5001/api
