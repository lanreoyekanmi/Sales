# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# CORS: comma-separated list of exact origins allowed to call this API from a browser.
# Required in production (requests are blocked by default if unset in production).
# Example: https://www.example.com,https://apply.example.com
ALLOWED_ORIGINS=

# Set to the number of reverse proxies in front of this app (e.g. 1) so Express reads the
# real client IP from X-Forwarded-For correctly. Leave unset if not running behind a proxy —
# setting this without an actual proxy lets clients spoof their IP and bypass rate limiting.
# On Vercel, set this to 1 — Vercel's edge network always sits in front of the Function, so
# without it req.ip (used for rate limiting) would read Vercel's edge instead of the real client.
TRUST_PROXY=

# Maximum JSON request body size accepted by the API.
MAX_REQUEST_BODY_SIZE=25kb

# Rate limiting for POST /api/applications (per IP).
APPLICATION_RATE_LIMIT_WINDOW_MS=900000
APPLICATION_RATE_LIMIT_MAX=10

# Document uploads (ID card / SSN card / selfie) for POST /api/applications and
# POST /api/applications/:id/documents.
MAX_DOCUMENT_UPLOAD_SIZE_BYTES=8388608
DOCUMENT_UPLOAD_RATE_LIMIT_WINDOW_MS=900000
DOCUMENT_UPLOAD_RATE_LIMIT_MAX=20

# Cloudinary: storage backend for verification document images. Required — the server fails
# to start without all three (see BACKEND/src/config/cloudinary.js). Get these from your
# Cloudinary dashboard; never commit real values here.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder documents are uploaded under. Purely organizational (lets you tell real vs. test
# uploads apart in the Cloudinary dashboard) — not a security boundary.
CLOUDINARY_UPLOAD_FOLDER=loan-applications

# Telegram: optional operational notification channel. On a successful application submission,
# the API sends an application summary and the three verification images to this bot/chat.
# Server-side only — never exposed to the frontend, logs, or API responses. Optional: if either
# value is unset, Telegram notifications are silently disabled and the rest of the API is
# unaffected. Never commit real values here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional HTTP timeout (ms) for calls to the Telegram Bot API. Defaults to 10000 if unset.
TELEGRAM_REQUEST_TIMEOUT_MS=
