# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# CORS: comma-separated list of exact origins allowed to call this API from a browser.
# Required in production (requests are blocked by default if unset in production).
# Example: https://www.example.com,https://apply.example.com
ALLOWED_ORIGINS=

# Set to the number of reverse proxies in front of this app (e.g. 1) so Express reads the
# real client IP from X-Forwarded-For correctly. Leave unset if not running behind a proxy —
# setting this without an actual proxy lets clients spoof their IP and bypass rate limiting.
TRUST_PROXY=

# Maximum JSON request body size accepted by the API.
MAX_REQUEST_BODY_SIZE=25kb

# Rate limiting for POST /api/applications (per IP).
APPLICATION_RATE_LIMIT_WINDOW_MS=900000
APPLICATION_RATE_LIMIT_MAX=10
